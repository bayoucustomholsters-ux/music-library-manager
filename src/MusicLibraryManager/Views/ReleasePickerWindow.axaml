<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="using:MusicLibraryManager.Models"
        x:Class="MusicLibraryManager.Views.ReleasePickerWindow"
        Title="Select MusicBrainz release"
        Width="640" Height="420"
        WindowStartupLocation="CenterOwner"
        CanResize="True">
  <DockPanel Margin="16">
    <TextBlock DockPanel.Dock="Top" Text="Choose a release to apply metadata and track titles:"
               Margin="0,0,0,8" TextWrapping="Wrap"/>
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right"
                Spacing="8" Margin="0,12,0,0">
      <Button Content="Use selected" Name="AcceptButton" Click="OnAcceptClick" Padding="16,8"
              Classes="accent"/>
      <Button Content="Cancel" Click="OnCancelClick" Padding="16,8"/>
    </StackPanel>
    <ListBox Name="CandidateList" SelectionMode="Single">
      <ListBox.ItemTemplate>
        <DataTemplate x:DataType="models:MusicBrainzReleaseCandidate">
          <TextBlock Text="{Binding DisplayLabel}" TextWrapping="Wrap" Margin="4"/>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
  </DockPanel>
</Window>
