<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:MusicLibraryManager.ViewModels"
        x:Class="MusicLibraryManager.Views.BatchCoverFillWindow"
        x:DataType="vm:BatchCoverFillViewModel"
        Title="Fill Missing Covers"
        Width="720" Height="520"
        WindowStartupLocation="CenterOwner"
        CanResize="True">
  <DockPanel Margin="16">
    <StackPanel DockPanel.Dock="Top" Spacing="8" Margin="0,0,0,12">
      <TextBlock Text="Fill Missing Covers" FontSize="18" FontWeight="Bold"/>
      <TextBlock TextWrapping="Wrap" Opacity="0.75"
                 Text="Select an artist folder whose immediate children are album folders. Albums that already have cover/folder/front/album art (jpg/jpeg/png) are skipped. Missing covers are looked up on MusicBrainz and saved as cover.jpg (first/best match, no per-album picker)."/>
      <Grid ColumnDefinitions="*,Auto">
        <TextBox Text="{Binding FolderPath}" Watermark="Artist folder (e.g. The Smashing Pumpkins)"/>
        <Button Grid.Column="1" Content="Browse" Command="{Binding BrowseFolderCommand}" Margin="8,0,0,0"/>
      </Grid>
      <StackPanel Orientation="Horizontal" Spacing="8">
        <Button Content="Start" Command="{Binding StartCommand}" IsEnabled="{Binding !IsBusy}" Classes="accent" Padding="16,8"/>
        <Button Content="Cancel" Command="{Binding CancelCommand}" IsEnabled="{Binding IsBusy}" Padding="16,8"/>
        <Button Content="Clear Log" Command="{Binding ClearLogCommand}" Padding="12,8"/>
        <Button Content="Close" Click="OnCloseClick" Padding="16,8"/>
      </StackPanel>
      <Grid ColumnDefinitions="*,Auto" Margin="0,4,0,0">
        <ProgressBar Minimum="0" Maximum="100" Value="{Binding Progress}" Height="18"/>
        <TextBlock Grid.Column="1" Text="{Binding ProgressText}" Margin="12,0,0,0" VerticalAlignment="Center" MinWidth="80"/>
      </Grid>
      <TextBlock Text="{Binding StatusText}" Opacity="0.85" TextWrapping="Wrap"/>
    </StackPanel>

    <Border Padding="8" CornerRadius="6" BorderBrush="#33FFFFFF" BorderThickness="1">
      <DockPanel>
        <TextBlock DockPanel.Dock="Top" Text="Log" FontWeight="SemiBold" Margin="0,0,0,4"/>
        <TextBox Text="{Binding LogText}" IsReadOnly="True" AcceptsReturn="True"
                 TextWrapping="Wrap" FontFamily="Consolas,Courier New,monospace" FontSize="12"
                 VerticalContentAlignment="Top"/>
      </DockPanel>
    </Border>
  </DockPanel>
</Window>
